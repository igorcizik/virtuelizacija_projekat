<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<bindings>
		<netTcpBinding>
			<binding name="TcpStreamingBinding"
					 transferMode="Streamed"
					 maxReceivedMessageSize="104857600"
					 sendTimeout="00:10:00"
					 receiveTimeout="00:10:00">
				<security mode="None" />
			</binding>
		</netTcpBinding>
	</bindings>
	<system.serviceModel>
		<client>
			<endpoint name="Obrada"
			address="net.tcp://localhost:4000/Service"
			binding="netTcpBinding"
			bindingConfiguration="TcpStreamingBinding"
			contract="Client.ISession" />
		</client>
		
	</system.serviceModel>

	<appSettings>
		<add key="Csv_path" value="Data\measures_v2.csv" />
		<add key="Csv_log_path" value="ClientLogs\csv_import_log.txt" />
		<add key="Max_rows" value="125" />
	</appSettings>
</configuration>