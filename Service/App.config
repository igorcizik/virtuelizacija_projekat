<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="TcpStreamingBinding"
						 transferMode="Streamed"
						 maxReceivedMessageSize="104857600"
						 openTimeout="00:01:00"
						 closeTimeout="00:01:00"
						 sendTimeout="00:10:00"
						 receiveTimeout="00:10:00">
					<security mode="None" />
				</binding>
			</netTcpBinding>
		</bindings>
		<services>
			<service name="Service.SessionService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4000"
/>
					</baseAddresses>
				</host>
				<!-- Service Endpoints -->
				<endpoint
				address="Service"
				binding="netTcpBinding"
				bindingConfiguration="TcpStreamingBinding"
				contract="Common.ISession" />
			</service>
		</services>
	</system.serviceModel>
	<appSettings>
		<add key="Stator_w_threshold" value="100"/>
		<add key="Stator_t_threshold" value="90"/>
		<add key="PM_threshold" value="85"/>
	</appSettings>
</configuration>
